@startuml
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam defaultFontSize 11
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 25
skinparam ranksep 35
skinparam Padding 4

skinparam package {
    BackgroundColor #FFFFFF
    BorderColor #334155
    BorderThickness 1.5
    FontColor #0F172A
    FontSize 12
}

skinparam component {
    BackgroundColor #F8FAFC
    BorderColor #334155
    BorderThickness 1.2
    FontColor #0F172A
    FontSize 11
}

skinparam interface {
    BackgroundColor #E2E8F0
    BorderColor #1E293B
    FontColor #0F172A
}

skinparam arrow {
    Color #334155
    FontColor #0F172A
    FontSize 10
}

package "Tier 1: Constrained Edge Node (Event-Driven Pipelined C99 Architecture)" as Tier1 {
    component "Physical Network / ISR Ingress\n(UART / SPI / Ethernet MAC)" as NetIngress
    component "CPU Stress & Benchmark Harness\n(Idle vs. 64x64 MatMul Load + DWT CYCCNT)" as StressGen

    package "libmicroshield (ANSI C99 Static Library - Zero Malloc)" as CoreLib {
        component "ms_extract_features()\n[O(1) Sliding Window & Q8 Entropy LUT]" as CompExtract
        component "ms_evaluate_tree()\n[O(depth) Static Node Array Interpreter]" as CompTree
        component "ms_update_fsm()\n[5-State Leaky Bucket & Exp. Backoff FSM]" as CompFSM
        component "ms_pack_telemetry_frame()\n[24-Byte Binary Serializer + CRC-16]" as CompCodec
    }

    NetIngress --> CompExtract : raw frame event
    StressGen ..> CoreLib : contends for CPU/FPU registers
    CompExtract --> CompTree : ms_feature_vec_t (12B aligned)
    CompTree --> CompFSM : ms_verdict_t + XAI rule_id
    CompFSM --> NetIngress : hardware action (Allow / Drop / Lockdown RX)
    CompFSM --> CompCodec : alerts (100%) & boundary benign (1:K)
}

package "Tier 2: Dashield Fleet Orchestrator (100% Pure Python Hexagonal OOP + Poetry)" as Tier2 {

    package "Inbound & Outbound Adapters (Ports & Adapters Layer)" as Adapters {
        component "TelemetryTransportPort\n<<Strategy Pattern>>\n(PySerial UART / TCP Socket Bridge)" as PortTransport
        component "Dashield 5-Tab Streamlit UI\n<<MVC View Adapter>>\n(Pure Python Interactive Console)" as PortUI
        component "SQLite & JSON Audit Adapter\n<<Repository Pattern>>\n(NIS 2 / EU CRA Persistence)" as PortRepo
    }

    package "Dashield Application Core (Domain & MLOps Services)" as AppCore {
        component "DashieldOrchestratorFacade\n<<Facade Pattern>>" as CoreFacade
        component "TelemetryEventBus\n<<Observer Pattern>>" as CoreBus
        component "ShadowAuditEnsembleService\n(100-Tree Random Forest FN Hunter)" as CoreShadow
        component "ConceptDriftAndGaugeService\n(PSI / K-S & Retraining Readiness Gauge)" as CoreDrift
        component "C99TreeTranspilerFactory\n<<Builder / Factory Pattern>>\n(Scikit-Learn -> ms_tree_node_t[])" as CoreTranspiler
    }

    CompCodec ==> PortTransport : 24-Byte Binary Stream (CRC-16)
    PortTransport ==> CompFSM : 8-Byte Control Cmd (Reset / OTA Tree)

    PortTransport --> CoreBus : publishes decoded frames
    CoreBus --> CoreShadow : notifies on benign audit sample
    CoreBus --> CoreDrift : notifies on feature vector
    CoreBus --> PortRepo : persists incidents & telemetry

    PortUI <--> CoreFacade : invokes use-cases & reads state
    CoreFacade --> CoreShadow : queries unmasked FNs
    CoreFacade --> CoreDrift : reads Readiness Gauge (0-100%)
    CoreFacade --> CoreTranspiler : triggers retraining & C99 export
    CoreFacade --> PortRepo : exports NIS 2 / CRA dossiers
    CoreTranspiler --> PortTransport : broadcasts updated node array
}

@enduml
