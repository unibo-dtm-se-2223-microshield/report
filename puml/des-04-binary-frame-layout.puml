@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam defaultFontSize 11
skinparam shadowing false
skinparam rectangle {
    BackgroundColor #F8FAFC
    BorderColor #334155
    FontColor #0F172A
}

title MicroShield 24-Byte Binary Frame Layout (32-bit Word Aligned)

rectangle "Word 0 (Offset 0x00-0x03)" as W0 {
    [sync_word (0xAA55)\n2B] as f1 #E2E8F0
    [msg_type\n1B] as f2 #CBD5E1
    [node_id\n1B] as f3 #CBD5E1
}

rectangle "Word 1 (Offset 0x04-0x07)" as W1 {
    [seq_ts (Monotonic Timestamp / Counter)\n4 Bytes] as f4 #FEF3C7
}

rectangle "Word 2 (Offset 0x08-0x0B)" as W2 {
    [verdict\n1B] as f5 #FEE2E2
    [fsm_state\n1B] as f6 #FEE2E2
    [rule_id\n2B] as f7 #FEF3C7
}

rectangle "Word 3 (Offset 0x0C-0x0F)" as W3 {
    [feat_iat (Inter-Arrival Delta us)\n4 Bytes] as f8 #ECFDF5
}

rectangle "Word 4 (Offset 0x10-0x13)" as W4 {
    [feat_len\n2B] as f9 #ECFDF5
    [feat_ent\n1B] as f10 #ECFDF5
    [feat_rate\n1B] as f11 #ECFDF5
}

rectangle "Word 5 (Offset 0x14-0x17)" as W5 {
    [aux_meta\n2B] as f12 #F1F5F9
    [crc16\n2B] as f13 #DCFCE7
}

W0 -[hidden]-> W1
W1 -[hidden]-> W2
W2 -[hidden]-> W3
W3 -[hidden]-> W4
W4 -[hidden]-> W5

legend right
  **Design Guarantees:**
  * Exact Size: 24 Bytes (Multiple of 4 & 8)
  * Alignment: 32-bit Natural Word Alignment
  * Checksum: ITU-T CRC-16-CCITT (0x1021)
end legend

@enduml
