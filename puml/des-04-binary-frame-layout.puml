@startuml
skinparam backgroundColor #FFFFFF
skinparam defaultFontName SansSerif
skinparam defaultFontSize 11
skinparam shadowing false
skinparam rectangle {
    BackgroundColor #F8FAFC
    BorderColor #334155
    FontColor #0F172A
}

title MicroShield 24-Byte Binary Frame Layout (32-bit Aligned)

rectangle "Byte Offset 00 - 03 (Header & Routing)" {
    [Bytes 00-01: sync_word (0xAA55)] as b1 #E2E8F0
    [Byte 02: msg_type (0x01/02/10)] as b2 #E2E8F0
    [Byte 03: node_id (0x01..0xFF)] as b3 #E2E8F0
}

rectangle "Byte Offset 04 - 0B (Timestamp, Verdict & Rule)" {
    [Bytes 04-07: seq_ts (Monotonic Timestamp ms)] as b4 #FEF3C7
    [Byte 08: verdict (0=Benign, 1..3=Anomaly)] as b5 #FEE2E2
    [Byte 09: fsm_state (0..4 FSM Level)] as b6 #FEE2E2
    [Bytes 10-11: rule_id (CART Leaf ID)] as b7 #FEF3C7
}

rectangle "Byte Offset 0C - 13 (Extracted 8-Feature Vector Q8)" {
    [Bytes 12-15 (Offset 0C-0F): feat_iat (Inter-Arrival Δ us)] as b8 #ECFDF5
    [Bytes 16-17 (Offset 10-11): feat_len (Frame Length)] as b9 #ECFDF5
    [Byte 18 (Offset 12): feat_ent (Shannon Entropy Q8)] as b10 #ECFDF5
    [Byte 19 (Offset 13): feat_rate (Sliding Rate)] as b11 #ECFDF5
}

rectangle "Byte Offset 14 - 17 (Metadata & Integrity)" {
    [Bytes 20-21 (Offset 14-15): aux_meta (Margin / Cmd Arg)] as b12 #F1F5F9
    [Bytes 22-23 (Offset 16-17): crc16 (ITU-T CRC-16-CCITT 0x1021)] as b13 #DCFCE7
}

b1 --> b4 : 32-bit Word Alignment
b4 --> b8
b8 --> b12

legend right
  **Design Invariants:**
  * Exact footprint: 24 Bytes (Multiple of 4 & 8)
  * Zero Heap Allocation (Stack serialized)
  * Transport Agnostic (UART, 4G/5G, LoRa, TCP)
  * Bandwidth overhead: <= 2.08% at 115,200 bps
end legend

@enduml
