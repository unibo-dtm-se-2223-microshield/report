@startuml design_deployment
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundcorner 8
skinparam shadowing false

skinparam node {
    BackgroundColor #F8F9FA
    BorderColor #2B2D42
    BorderThickness 1.5
    FontColor #2B2D42
    FontStyle bold
    FontSize 13
}

skinparam artifact {
    BackgroundColor #EDF2F4
    BorderColor #8D99AE
    BorderThickness 1.2
    FontColor #2B2D42
    FontSize 11
}

skinparam rectangle {
    BackgroundColor #F1F3F5
    BorderColor #2B2D42
    BorderThickness 1.5
    FontColor #2B2D42
}

skinparam arrow {
    Color #2B2D42
    FontColor #2B2D42
    FontSize 11
}

title <size:15><b>MicroShield - Distributed Deployment & Physical Infrastructure</b></size>\n

' Requisiti Normativi posizionati in alto al centro
rectangle "<b>CRA / NIS 2 Regulatory Compliance Boundary</b>\n--\n• Zero Dynamic Heap Allocation (MISRA C:2012)\n• Isolated Diagnostic Telemetry Bus (Out-of-Band)\n• Cryptographic Append-Only Audit Trail (SHA-256)" as Boundary

node "<<device>> Field Operational Network\n(Sensors, Actuators & Industrial PLC)" as FieldNet {
    [Industrial Field Traffic Generator\n(Modbus RTU / Ethernet Frame Source)] as TrafficGen
}

node "<<device>> Industrial Edge Node\n(STM32F407VGT6 Microcontroller)" as MCU {
    node "<<execution environment>> Bare-Metal ARM Cortex-M4 (168 MHz)" as MCURuntime {
        artifact "core_firmware.elf\n(Primary Sensing & Actuation)" as CoreELF
        artifact "libmicroshield.a\n(Inline Data-Link IDS Engine)" as IDSLib
        artifact "transpiled_model.h\n(Static Decision Matrix)" as ModelHeader
        
        IDSLib ..> ModelHeader : <<includes>>
        CoreELF ..> IDSLib : <<statically links>>
    }
}

node "<<device>> Supervisory Operations Station\n(x86_64 Industrial Workstation / Host PC)" as Workstation {
    node "<<execution environment>> CPython 3.11+ Runtime / Linux" as PyRuntime {
        artifact "telemetry_daemon.py\n(COBS Ingestion & SQLite Logger)" as DaemonPy
        artifact "drift_monitor.py\n(Rolling Window Statistical Evaluator)" as DriftPy
        artifact "c_transpiler.py\n(AST Code Generator CLI)" as TranspilerPy
        artifact "web_dashboard.py\n(Dash/Plotly Visualization)" as DashboardPy
    }
}

' Canali di comunicazione operativi e diagnostici
TrafficGen -right-> IDSLib : In-Band Operational Link\n(Ethernet RMII / RS-485)\nInline Interception

IDSLib -down-> DaemonPy : Out-of-Band Diagnostic Link\n(USART / USB-VCP @ 115200 baud)\nFraming: COBS + CRC32

' Relazioni formali di conformità normativa orientate (..>)
MCU .up.> Boundary : <<enforces>>\n(Deterministic Latency\n& Zero-Heap)

Workstation .up.> Boundary : <<enforces>>\n(Forensic Audit Trail\n& Drift Logging)

@enduml
